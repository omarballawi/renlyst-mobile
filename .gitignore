# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
dist-android/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# User backups and imported clinical data never belong in git
backups/
fixtures/private/
*.renlyst-backup.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Test and tool output
coverage/
.maestro/screenshots/
.eslintcache

# Local release artifacts are reproducible from GitHub Actions and never committed
artifacts/

# Portable Graphify outputs stay tracked; machine-local runtime output does not
graphify-out/memory/
graphify-out/reflections/
graphify-out/raw/
graphify-out/.graphify_cache/
graphify-out/.graphify_history/
graphify-out/.graphify_analysis.json
graphify-out/.graphify_root
graphify-out/.graphify_detect.json
graphify-out/.graphify_extract.json
graphify-out/.graphify_ast.json
graphify-out/.graphify_semantic*.json
graphify-out/.graphify_cached.json
graphify-out/.graphify_uncached.txt
graphify-out/.graphify_chunk_*.json
graphify-out/.graphify_*.tmp
graphify-out/[0-9]*/
