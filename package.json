  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "26.1.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-expo": "^57.0.0",
    "expo-doctor": "^1.20.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.2",
    "prettier": "^3.9.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "e2e:maestro": "maestro test .maestro",
    "export:ios": "expo export --platform ios --output-dir dist --clear",
    "export:android": "expo export --platform android --output-dir dist-android --clear",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm format:check && pnpm exec expo-doctor",
    "release:verify": "pnpm verify && pnpm export:ios && pnpm export:android"
  },
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  }
